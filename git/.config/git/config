[user]
	name = Rioh
	email = 90512887+Rioh1118@users.noreply.github.com
[init]
	defaultBranch = main
[core]
	editor = nvim
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
[merge]
	conflictstyle = zdiff3
[diff]
	colorMoved = default
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[rerere]
	enabled = true
[alias]
	ci = commit
	st = status
	br = branch
	co = checkout
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f

# 署名鍵などマシン固有の設定（Git 管理外）。新 Mac のセットアップで作る。
[include]
	path = ~/.config/git/config.local
